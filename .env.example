APP_ENV=development

# ── Base Path ─────────────────────────────────────────────────────────────────
# Leave blank to auto-detect. Only set this if the app is NOT at the web root.
# For XAMPP: if your project folder is "Inventra", set APP_BASE_PATH=/Inventra/public
# For a root-domain server (or Railway/Docker): leave blank or set to empty.
APP_BASE_PATH=

# ── Mail Configuration ────────────────────────────────────────────────────────
MAIL_FROM_ADDRESS=no-reply@inventra.local
MAIL_FROM_NAME=Inventra

# Local dev: write emails to a log file instead of sending (leave blank to send)
# Path is relative to the project root, or an absolute path.
MAIL_LOG_PATH=uploads/mail.log

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventra
DB_USER=root
DB_PASS=

# ── AI Sales Insight (Groq) ───────────────────────────────────────────────────
# Endpoint: leave blank to use the default Groq completions endpoint.
# Key: your Groq API key.
AI_INSIGHTS_ENDPOINT=
AI_INSIGHTS_MODEL=llama-3.3-70b-versatile
AI_INSIGHTS_API_KEY=

# ── Seed / First-Run Manager Account ─────────────────────────────────────────
# These credentials are used when the database is first created.
SEED_MANAGER_EMAIL=manager@inventra.local
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=password
