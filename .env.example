# APP_BASE_PATH=/Inventra/public
# APP_URL=http://localhost/Inventra/public

# ── Mail Configuration ────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@inventra.local
MAIL_FROM_NAME=Inventra
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=15
MAIL_AUTH=true

# Local dev: write emails to a log file instead of sending (leave blank to send)
# Path is relative to the project root, or an absolute path.
MAIL_LOG_PATH=uploads/mail.log

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventra
DB_USER=root
DB_PASS=

# ── AI Sales Insight (Gemini) ──────────────────────────────────────────────────
# Endpoint: leave blank to use the default Gemini completions endpoint.
# Key: your Gemini API key.
AI_INSIGHTS_API_KEY="AIzaSyCoqEFigAofEG52r1ihfBPqvG4A7ylZU9A"
AI_INSIGHTS_ENDPOINT="https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-live:generateContent"
AI_MODEL_NAME="Gemini 3 Flash Live"

# ── Seed / First-Run Manager Account ─────────────────────────────────────────
# These credentials are used when the database is first created.
SEED_MANAGER_EMAIL=manager@inventra.local
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=password
