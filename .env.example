APP_ENV=production
APP_BASE_PATH=/Inventra/public
APP_URL=http://localhost/Inventra/public

# ── Mail Configuration ────────────────────────────────────────────────────────
# Sender identity
MAIL_FROM_ADDRESS=no-reply@inventra.local
MAIL_FROM_NAME=Inventra

# Local dev: write emails to a log file instead of sending (leave blank to send)
# Path is relative to the project root, or an absolute path.
MAIL_LOG_PATH=uploads/mail.log

# SMTP settings (used by mail() via php.ini — configure php.ini SMTP settings,
# or use a library like PHPMailer and add SMTP_HOST/PORT/USER/PASS here)
# SMTP_HOST=localhost
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventra
DB_USER=inventra_app
DB_PASS=

# AI monthly sales insight service
# Expected response format: {"summary":"2-3 sentence summary"}
AI_INSIGHTS_ENDPOINT=
AI_INSIGHTS_API_KEY=

# ── Seeds ────────────────────────────────────────────────────────────────────
SEED_MANAGER_EMAIL=manager@inventra.local
SEED_MANAGER_USERNAME=manager
# Password will be generated securely during seeding if not set here
# SEED_MANAGER_PASSWORD=
